[Unit]
Description=Notes Browser FastAPI Backend
After=network.target

[Service]
Type=simple
User=alanzoppa
WorkingDirectory=/Users/alanzoppa/Code/notes-browser/backend
ExecStart=/Users/alanzoppa/Code/notes-browser/backend/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target