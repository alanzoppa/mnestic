# This is the public template. Copy to deploy.yml and customize for your runner.
name: Deploy
on:
  push:
    branches: [main]
  workflow_dispatch:
concurrency:
  group: deploy
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: [self-hosted, linux, x64]
    steps:
      - uses: actions/checkout@v4
      - name: Copy docker-compose.yml
        run: cp /path/to/your/docker-compose.yml docker-compose.yml
      - name: Deploy
        run: bash scripts/deploy.sh
